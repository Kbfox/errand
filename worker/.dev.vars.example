# Copy to .dev.vars (gitignored). Values from developer.paypal.com → Apps & Credentials → Sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# trychannel3.com dashboard
CHANNEL3_API_KEY=

# Copy to .dev.vars (gitignored). Values from developer.paypal.com → Apps & Credentials → Sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# trychannel3.com dashboard
CHANNEL3_API_KEY=
# only if LLM_PROVIDER=openai-compatible (DeepSeek / OpenAI / Qwen ...)
LLM_API_KEY=
# any random string; the iOS app sends it as X-App-Key
APP_KEY=dev-local
# APNs auth key (.p8) contents with 
 line breaks, one line; only needed for push
APNS_KEY=
